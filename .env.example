# ---- Netlify (Site settings → Environment variables). Never commit real values. ----

# Login password for the app (single user). Use a long passphrase.
APP_PASSWORD=
# Random string, 32+ chars, signs the login cookie. e.g. `openssl rand -base64 48`
SESSION_SECRET=
# Google service account key JSON (raw or base64) - the same account n8n uses.
# The spreadsheet must be shared with its client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
# From the sheet URL: docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=
# Claude API key for the caption assistant (console.anthropic.com)
ANTHROPIC_API_KEY=
# Bearer token n8n uses to call /api/captions (also put it in the sheet config tab as app_api_token)
API_TOKEN=
# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium   # low | medium | high

# ---- Local only (n8n build/deploy). SPREADSHEET_ID above is reused. ----
TELEGRAM_CHAT_ID=
# `npm run n8n:deploy`: your n8n base URL and an API key (n8n → Settings → n8n API)
N8N_URL=https://YOUR-INSTANCE.app.n8n.cloud
N8N_API_KEY=

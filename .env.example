# העתק לקובץ .env (cp .env.example .env) ומלא. הקובץ .env לא נכנס לגיט.
# משתנים שמסומנים [Netlify] מגדירים גם ב-Netlify: Site configuration → Environment variables.

# ============ האפליקציה [Netlify + מקומי] ============

# סיסמת הכניסה לאפליקציה. משפט ארוך.
APP_PASSWORD=

# מחרוזת אקראית של 32+ תווים לחתימת ה-cookie.  ליצירה: openssl rand -base64 48
SESSION_SECRET=

# Railway → שירות ה-Postgres → Variables → הערך של DATABASE_PUBLIC_URL (מתחיל ב-postgresql://)
DATABASE_URL=

# מפתח Claude לעוזר הקפשנים: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# מחרוזת אקראית נוספת. n8n משתמש בה כדי לבקש קפשן מהאפליקציה.
# אותו ערך יישמר גם בטבלת settings בשם app_api_token (הסקריפט של ההעברה עושה את זה).   ליצירה: openssl rand -hex 24
API_TOKEN=

# ============ n8n [מקומי בלבד] ============

# כתובת ה-n8n שלך, בלי / בסוף. למשל https://xxx.app.n8n.cloud
N8N_URL=

# n8n → Settings → n8n API → Create an API key
N8N_API_KEY=

# n8n → Credentials → Create → Postgres (עם פרטי ה-DB מ-Railway) → שמירה.
# המזהה הוא החלק האחרון בכתובת של ה-credential: .../home/credentials/<המזהה>
N8N_POSTGRES_CREDENTIAL_ID=

# ה-chat id שלך בטלגרם (אותו מספר כמו telegram_chat_id בלשונית config של הגיליון)
TELEGRAM_CHAT_ID=

# ============ העברה חד-פעמית מהגיליון [מקומי בלבד] ============
# צריך רק להרצה אחת של npm run db:import-sheet. אחרי ההעברה אפשר למחוק.

# תוכן קובץ ה-JSON של ה-service account (שורה אחת, או base64). הגיליון משותף איתו.
GOOGLE_SERVICE_ACCOUNT_JSON=
# מה-URL של הגיליון: docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=

# ============ לא חובה ============
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium            # low | medium | high
